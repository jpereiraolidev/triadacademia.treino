// ============================================
// schema.prisma — Triad Academia · v3.0
// ============================================
// Modelo de dados profissional, com:
//   - Invite seguro (id + exp + nonce + hmac revalidável)
//   - Ordem única de exercícios por treino
//   - Soft delete padronizado (active)
//   - Preços em Decimal(10,2) (nunca Float)
//   - Índices otimizados para os padrões de query do routes.js
//
// Decisões de modelagem (v3.0):
//   - Membership: múltiplas ativas permitidas (validação na app)
//   - Checkin: origem validada na app (device OU registeredBy)
//   - User.email / Student.email: podem coincidir entre tabelas
//   - Preços: Decimal(10,2)
//   - Soft delete: active Boolean
//   - Auditoria: focada em Invite e transações críticas
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  PROFESSOR
  RECEPCAO
  ALUNO       // contas de aluno vindas de convite
}

enum WorkoutStatus {
  ATIVO
  FINALIZADO
  ARQUIVADO
}

enum MembershipStatus {
  ATIVA
  VENCIDA
  CANCELADA
  SUSPENSA
}

enum CheckinType {
  ENTRADA
  SAIDA
}

enum CheckinStatus {
  AUTORIZADO
  NEGADO
}

enum InviteType {
  ALUNO       // recadastro de aluno legado
  STAFF       // convite para funcionário
}

enum InviteStatus {
  PENDING     // criado, aguardando envio
  SENT        // mensagem enviada
  ACCEPTED    // aceito — conta criada
  REVOKED     // cancelado pelo admin
  EXPIRED     // prazo estourou
}

// ============================================
// USER
// ============================================
// Conta de acesso ao sistema. Separada de Student porque:
//   - Staff (ADMIN/PROFESSOR/RECEPCAO) não é aluno
//   - Aluno pode existir como Student sem ter User (legado)
//   - Aluno com User tem vínculo 1:1 opcional
// ============================================
model User {
  id       String   @id @default(cuid())
  name     String   @db.VarChar(120)
  email    String   @unique @db.VarChar(160)
  password String   @db.VarChar(255)
  role     UserRole @default(PROFESSOR)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações de negócio
  createdWorkouts WorkoutPlan[] @relation("WorkoutCreator")
  checkins        Checkin[]     @relation("CheckinRegisteredBy")

  // Vínculo 1:1 opcional com Student (o FK fica em Student)
  student Student? @relation("UserStudent")

  // Convites
  invitesCreated  Invite[] @relation("InviteCreatedBy")
  invitesAccepted Invite[] @relation("InviteAcceptedBy")

  @@index([email])
  @@index([active])
  @@index([role, active])
}

// ============================================
// STUDENT
// ============================================
// Cadastro do aluno. Pode existir sem User (legado/importação)
// ou com User (aluno que aceitou convite e criou conta).
// ============================================
model Student {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(120)
  email     String?   @unique @db.VarChar(160)
  phone     String?   @db.VarChar(20)
  birthDate DateTime?

  // Rastreamento do sistema legado (migração)
  legacyId   String? @unique @db.VarChar(80)
  legacyData Json?

  // FK para User (1:1 opcional — preenchida quando o aluno se recadastra)
  // onDelete: SetNull — se o User for removido, o Student continua existindo
  userId String? @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações de negócio
  workoutPlans WorkoutPlan[]
  memberships  Membership[]
  checkins     Checkin[]

  // Vínculo 1:1 com User
  user User? @relation("UserStudent", fields: [userId], references: [id], onDelete: SetNull)

  // Convites apontando para este aluno
  invites Invite[]

  @@index([name])
  @@index([active])
  @@index([legacyId])
  @@index([userId])
}

// ============================================
// PLAN
// ============================================
model Plan {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(80)
  description String? @db.Text

  price        Decimal @db.Decimal(10, 2)  // nunca Float para dinheiro
  durationDays Int

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([name])
  @@index([active])
}

// ============================================
// MEMBERSHIP
// ============================================
// Decisão v3.0: múltiplas matrículas ativas permitidas por aluno.
// A regra "uma ativa por vez" é validada na camada de aplicação
// (routes.js), não no banco — preserva histórico para auditoria.
// ============================================
model Membership {
  id        String @id @default(cuid())
  studentId String
  planId    String

  startDate DateTime
  endDate   DateTime

  priceAtPurchase Decimal @db.Decimal(10, 2)

  status MembershipStatus @default(ATIVA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  checkins Checkin[]

  @@index([studentId, status])
  @@index([studentId, endDate])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

// ============================================
// DEVICE
// ============================================
// Catraca/totem físico. Autentica via X-Device-Key (hash com pepper).
// ============================================
model Device {
  id         String @id @default(cuid())
  name       String @db.VarChar(80)
  identifier String @unique @db.VarChar(80)

  apiKeyHash String @unique @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkins Checkin[]

  @@index([identifier])
  @@index([active])
}

// ============================================
// CHECKIN
// ============================================
// Decisão v3.0: origem (device OU registeredBy) validada na app.
// Pelo menos um dos dois deve estar preenchido — regra de negócio.
// ============================================
model Checkin {
  id String @id @default(cuid())

  studentId String

  membershipId String?
  deviceId     String?
  registeredBy String?

  type   CheckinType
  status CheckinStatus

  reason String? @db.Text

  createdAt DateTime @default(now())

  student        Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  membership     Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  device         Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  registeredUser User?       @relation("CheckinRegisteredBy", fields: [registeredBy], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([membershipId])
  @@index([deviceId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ============================================
// EXERCISE
// ============================================
model Exercise {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  muscleGroup String? @db.VarChar(255)
  videoUrl    String? @db.VarChar(500)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([muscleGroup])
  @@index([active])
}

// ============================================
// WORKOUT PLAN
// ============================================
model WorkoutPlan {
  id        String @id @default(cuid())
  studentId String
  createdBy String

  name        String  @db.VarChar(120)
  description String? @db.Text

  status WorkoutStatus @default(ATIVO)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  creator User    @relation("WorkoutCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  exercises WorkoutExercise[]

  @@index([studentId])
  @@index([createdBy])
  @@index([status])
  @@index([studentId, status])
}

// ============================================
// WORKOUT EXERCISE
// ============================================
// Decisão v3.0: @@unique([workoutId, order]) impede ordem duplicada
// dentro do mesmo treino. O routes.js faz orderBy: { order: 'asc' },
// então duplicata quebraria a ordenação determinística.
// ============================================
model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String

  order Int

  sets        Int?
  repetitions String?  @db.VarChar(40)
  weight      Decimal? @db.Decimal(8, 2)
  restSeconds Int?
  notes       String?  @db.Text

  createdAt DateTime @default(now())

  workout  WorkoutPlan @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, order])
  @@index([workoutId])
  @@index([exerciseId])
}

// ============================================
// INVITE — v3.0 (seguro)
// ============================================
// Estrutura do token: <id>.<hmac>
//   - id:    12 bytes aleatórios → base64url → 16 chars
//   - exp:   Unix timestamp (segundos) — vem de expiresAt
//   - nonce: 4 bytes aleatórios → hex → 8 chars
//   - hmac:  HMAC-SHA256(id + ":" + exp + ":" + nonce) truncado em 10 bytes → base64url → 14 chars
//   - token completo: <id>.<hmac> (~31 chars)
//
// Por que nonce agora é persistido:
//   Sem ele, o HMAC não pode ser revalidado (o nonce era gerado e perdido).
//   Com ele no banco, GET /invites/:token recalcula:
//     expected = signInvite({ id, exp: expiresAt/1000, nonce })
//     e compara com invite.hmac em tempo constante.
//   Isso fecha a falha de segurança de forja do HMAC.
// ============================================
model Invite {
  id String @id @db.VarChar(16)

  // Token completo = id + "." + hmac (guardado para lookup rápido)
  token String @unique @db.VarChar(40)

  // HMAC isolado (revalidável agora que nonce é persistido)
  hmac String @db.VarChar(14)

  // Nonce usado no cálculo do HMAC (necessário para revalidar)
  nonce String @db.VarChar(8)

  // Quem criou (admin)
  createdById String

  // Vínculo com aluno legado (opcional — só quando type=ALUNO)
  studentId String?

  // Alvo — para envio e matching
  email String? @db.VarChar(160)
  phone String? @db.VarChar(20)
  name  String? @db.VarChar(120)

  // O que será criado ao aceitar
  type InviteType
  role UserRole?  // só quando type=STAFF

  // Ciclo de vida
  status    InviteStatus @default(PENDING)
  expiresAt DateTime

  // Tracking de envio
  sentAt       DateTime?
  sentVia      String? @db.VarChar(20)   // "whatsapp" | "sms" | "email"
  reminderSent Int     @default(0)

  // Auditoria
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  acceptedAt   DateTime?
  acceptedById String?

  // Relações
  createdBy  User     @relation("InviteCreatedBy",  fields: [createdById],  references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([studentId])
  @@index([email])
  @@index([phone])
  @@index([status, expiresAt])
  @@index([status, sentAt])
  @@index([createdById])
}