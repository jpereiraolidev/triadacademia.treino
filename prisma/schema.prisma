// ============================================
// CONFIG
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  PROFESSOR
  RECEPCAO
  ALUNO       // ← contas de aluno vindas de convite
}

enum WorkoutStatus {
  ATIVO
  FINALIZADO
  ARQUIVADO
}

enum MembershipStatus {
  ATIVA
  VENCIDA
  CANCELADA
  SUSPENSA
}

enum CheckinType {
  ENTRADA
  SAIDA
}

enum CheckinStatus {
  AUTORIZADO
  NEGADO
}

// ← tipos de convite
enum InviteType {
  ALUNO       // recadastro de aluno legado
  STAFF       // convite para funcionário
}

// ← ciclo de vida do convite
enum InviteStatus {
  PENDING     // criado, aguardando envio
  SENT        // mensagem enviada
  ACCEPTED    // aceito — conta criada
  REVOKED     // cancelado pelo admin
  EXPIRED     // prazo estourou
}

// ============================================
// USER
// ============================================
model User {
  id       String   @id @default(cuid())
  name     String   @db.VarChar(120)
  email    String   @unique @db.VarChar(160)
  password String   @db.VarChar(255)
  role     UserRole @default(PROFESSOR)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relações existentes
  createdWorkouts WorkoutPlan[] @relation("WorkoutCreator")
  checkins        Checkin[]     @relation("CheckinRegisteredBy")

  // vínculo com Student (1:1 opcional — quando role = ALUNO)
  // Este lado NÃO tem FK — o Student é quem aponta pra cá
  student Student? @relation("UserStudent")

  // convites criados por este usuário (admin)
  invitesCreated Invite[] @relation("InviteCreatedBy")

  // convites aceitos por este usuário
  invitesAccepted Invite[] @relation("InviteAcceptedBy")

  @@index([email])
  @@index([active])
  @@index([role, active])
}

// ============================================
// STUDENT
// ============================================
model Student {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(120)
  email     String?   @unique @db.VarChar(160)
  phone     String?   @db.VarChar(20)
  birthDate DateTime?

  // rastreamento do sistema legado (migração)
  legacyId   String? @unique @db.VarChar(80)
  legacyData Json?

  // FK para User (1:1 opcional — preenchida quando o aluno se recadastra)
  // Este lado CARREGA a foreign key
  userId String? @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relações existentes
  workoutPlans WorkoutPlan[]
  memberships  Membership[]
  checkins     Checkin[]

  // relação 1:1 com User (com fields/references explícitos)
  user User? @relation("UserStudent", fields: [userId], references: [id], onDelete: SetNull)

  // convites apontando para este aluno
  invites Invite[]

  @@index([name])
  @@index([active])
  @@index([legacyId])
  @@index([userId])
}

// ============================================
// PLAN
// ============================================
model Plan {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(80)
  description String? @db.Text

  price        Decimal @db.Decimal(10, 2)
  durationDays Int

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([name])
  @@index([active])
}

// ============================================
// MEMBERSHIP
// ============================================
model Membership {
  id        String @id @default(cuid())
  studentId String
  planId    String

  startDate DateTime
  endDate   DateTime

  priceAtPurchase Decimal @db.Decimal(10, 2)

  status MembershipStatus @default(ATIVA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  checkins Checkin[]

  @@index([studentId, status])
  @@index([studentId, endDate])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

// ============================================
// DEVICE
// ============================================
model Device {
  id         String @id @default(cuid())
  name       String @db.VarChar(80)
  identifier String @unique @db.VarChar(80)

  apiKeyHash String @unique @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkins Checkin[]

  @@index([identifier])
  @@index([active])
}

// ============================================
// CHECKIN
// ============================================
model Checkin {
  id String @id @default(cuid())

  studentId String

  membershipId String?
  deviceId     String?
  registeredBy String?

  type   CheckinType
  status CheckinStatus

  reason String? @db.Text

  createdAt DateTime @default(now())

  student        Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  membership     Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  device         Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  registeredUser User?       @relation("CheckinRegisteredBy", fields: [registeredBy], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([membershipId])
  @@index([deviceId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ============================================
// EXERCISE
// ============================================
model Exercise {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  muscleGroup String? @db.VarChar(255)
  videoUrl    String? @db.VarChar(500)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([muscleGroup])
  @@index([active])
}

// ============================================
// WORKOUT PLAN
// ============================================
model WorkoutPlan {
  id        String @id @default(cuid())
  studentId String
  createdBy String

  name        String  @db.VarChar(120)
  description String? @db.Text

  status WorkoutStatus @default(ATIVO)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  creator User    @relation("WorkoutCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  exercises WorkoutExercise[]

  @@index([studentId])
  @@index([createdBy])
  @@index([status])
  @@index([studentId, status])
}

// ============================================
// WORKOUT EXERCISE
// ============================================
model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String

  order Int

  sets        Int?
  repetitions String?  @db.VarChar(40)
  weight      Decimal? @db.Decimal(8, 2)
  restSeconds Int?
  notes       String?  @db.Text

  createdAt DateTime @default(now())

  workout  WorkoutPlan @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutId])
  @@index([exerciseId])
}

// ============================================
// INVITE — Versão B1 (compacto)
// ============================================
// Estrutura do token: <id>.<hmac>
//   - id:   12 bytes aleatórios → base64url → 16 chars  (@id)
//   - hmac: HMAC-SHA256(id + exp + nonce) truncado em 10 bytes → base64url → 14 chars
//   - token completo: ~31 chars
//   - URL final: https://app/i/<token>  →  ~64 chars
// ============================================
model Invite {
  id String @id @db.VarChar(16)

  // Token completo = id + "." + hmac (guardado para lookup rápido)
  token String @unique @db.VarChar(40)

  // HMAC isolado (útil para auditoria/debug)
  hmac String @db.VarChar(14)

  // Quem criou (admin)
  createdById String

  // Vínculo com aluno legado (opcional — só quando type=ALUNO)
  studentId String?

  // Alvo — para envio e matching
  email String? @db.VarChar(160)
  phone String? @db.VarChar(20)
  name  String? @db.VarChar(120)

  // O que será criado ao aceitar
  type InviteType
  role UserRole?  // só quando type=STAFF

  // Ciclo de vida
  status    InviteStatus @default(PENDING)
  expiresAt DateTime

  // Tracking de envio
  sentAt       DateTime?
  sentVia      String? @db.VarChar(20)   // "whatsapp" | "sms" | "email"
  reminderSent Int     @default(0)

  // Auditoria
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  acceptedAt   DateTime?
  acceptedById String?

  // Relações
  createdBy  User     @relation("InviteCreatedBy",  fields: [createdById],  references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([studentId])
  @@index([email])
  @@index([phone])
  @@index([status, expiresAt])
  @@index([status, sentAt])
  @@index([createdById])
}